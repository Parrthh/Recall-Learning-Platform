generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TopicCategory {
  DSA
  SYSTEM_DESIGN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum QuestionStatus {
  ATTEMPTED
  SOLVED
  NEEDS_REVIEW
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  image          String?
  passwordHash   String?
  emailVerified  DateTime?
  createdAt      DateTime             @default(now())
  accounts       Account[]
  sessions       Session[]
  topicProgress  UserProgress[]
  questionStatus UserQuestionStatus[]
}

// Auth.js (NextAuth) adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Topic {
  id            String         @id @default(cuid())
  category      TopicCategory
  section       String // grouping within a category, e.g. "Foundations", "Fundamentals", "Case Studies"
  title         String
  slug          String         @unique
  order         Int
  summary       String         @default("")
  contentPath   String // path to the markdown file under content/
  prerequisites String[]       @default([]) // slugs of prerequisite topics
  questions     Question[]
  progress      UserProgress[]

  @@index([category, order])
}

model Question {
  id           String               @id @default(cuid())
  topicId      String
  slug         String               @unique
  title        String
  prompt       String
  difficulty   Difficulty
  hints        String[]             @default([])
  solutionMd   String
  sourceUrl    String?
  order        Int                  @default(0)
  topic        Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userStatuses UserQuestionStatus[]

  @@index([topicId, order])
}

model UserProgress {
  userId        String
  topicId       String
  status        TopicStatus @default(NOT_STARTED)
  theoryRead    Boolean     @default(false)
  lastStudiedAt DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
}

model UserQuestionStatus {
  userId       String
  questionId   String
  status       QuestionStatus
  nextReviewAt DateTime?
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, nextReviewAt])
}
